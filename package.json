{
  "name": "toolshop-playwright-framework",
  "version": "1.0.0",
  "description": "Playwright + TypeScript test framework for the Toolshop web shop: UI, API, accessibility and visual tests.",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --project=chromium --headed --workers=1",
    "report": "playwright show-report",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@eslint/js": "9.38.0",
    "@faker-js/faker": "10.1.0",
    "@playwright/test": "1.57.0",
    "@types/node": "^24.10.1",
    "dotenv": "17.2.3",
    "eslint": "9.38.0",
    "eslint-plugin-playwright": "2.3.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "zod": "4.1.12"
  }
}
