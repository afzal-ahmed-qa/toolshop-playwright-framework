# Which Toolshop to test: local (Docker), public (practicesoftwaretesting.com) or with-bugs.
ENV=public

# Optional overrides. Leave empty to use the preset for ENV.
BASE_URL=
API_URL=

# Seeded accounts. The defaults are the public demo accounts from the Toolshop README.
ADMIN_EMAIL=
ADMIN_PASSWORD=
CUSTOMER_EMAIL=
CUSTOMER_PASSWORD=
